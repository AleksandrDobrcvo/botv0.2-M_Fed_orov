{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tronix-game-app",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/telegram/*"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "FIREBASE_DATABASE_URL": "https://mfedorov-521cc-default-rtdb.firebaseio.com",
    "NOTIFICATION_BATCH_SIZE": "8"
  }
}
